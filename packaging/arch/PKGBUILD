# Maintainer: lyokha113 <lyokha113@gmail.com>
pkgname=lcquay-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Terminal UI for AWS ECR, ECR Public and OCI container registries"
arch=('x86_64')
url="https://github.com/lyokha113/lcquay"
license=('MIT')
depends=('gcc-libs' 'glibc')
optdepends=('docker: push, pull and login')
provides=('lcquay')
conflicts=('lcquay')
source=("$url/releases/download/v$pkgver/lcquay-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "lcquay-v$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 lcquay "$pkgdir/usr/bin/lcquay"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
